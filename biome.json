{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"src/**",
			"tests/**",
			"scripts/**",
			"*.ts",
			"*.mjs",
			"!src/node_modules",
			"!**/out",
			"!**/dist"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"preset": "none"
			},
			"style": {
				"noNonNullAssertion": "off"
			},
			"complexity": {
				"useArrowFunction": "off"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"formatter": {
		"enabled": false
	}
}
